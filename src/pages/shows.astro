---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
---

<BaseLayout>
    <div class="eventos">
        <div class="title">
            <h2>Eventos</h2>
        </div>
        <div class="gallery">
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(4).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(1).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(2).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(3).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(5).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(6).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(7).webp`} alt="Stand-up Lounge" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/stand-up(8).webp`} alt="Stand-up Lounge" />
        </div>
    </div>
  
</BaseLayout>