---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';

---

<BaseLayout>
    <div class="portraits">
        <div class="title">
            <h2>Retratos</h2>
        </div>
        <div class="gallery">
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/guilhermeGrade.webp`} alt="Guilherme Collection" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/guilhermePonte.webp`} alt="Guilherme Collection" />
            <PhotoCard src={`${import.meta.env.BASE_URL}/images/guilherme_telemovel.webp`} alt="Guilherme Collection" />
        </div>
    </div>
</BaseLayout>